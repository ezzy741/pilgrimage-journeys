# Example only. Provision real private configuration outside Git.
HOST=127.0.0.1
NITRO_HOST=127.0.0.1
PORT=3000
NITRO_PORT=3000
BOOKING_DATA_DIR=/opt/pilgrimage-journeys/shared/bookings
BOOKING_ADMIN_TOKEN_FILE=/opt/pilgrimage-journeys/shared/bookings/admin-token
BOOKING_TRUST_PROXY=0

# The token file must be owner-readable only (0600), in a private directory (0700).
# Admin keys require at least 32 non-whitespace characters.
# Do not define BOOKING_ADMIN_TOKEN as empty or a placeholder: it overrides the file.
# Keep existing local-model configuration in the private service environment.
